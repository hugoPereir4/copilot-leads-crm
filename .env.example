# Configuracao do PostgreSQL para desenvolvimento local.
# Copie para .env e preencha a senha antes de iniciar o banco.
POSTGRES_DB=copilot_leads
POSTGRES_USER=copilot_dev
POSTGRES_PASSWORD=
# Endereco e porta publicados no Windows, usados pela API fora do container.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Porta HTTP da API local; o servidor escuta em 127.0.0.1.
API_PORT=3000

# Qualificacao administrativa: nenhuma API externa no modo padrao.
QUALIFIER_PROVIDER=simulated
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Com gemini, o Google exige prazo minimo de 10000 ms (abaixo disso responde 400 INVALID_ARGUMENT).
QUALIFIER_TIMEOUT_MS=25000
QUALIFIER_MAX_CONTEXT_CHARS=8000
QUALIFIER_MAX_OUTPUT_CHARS=4000
