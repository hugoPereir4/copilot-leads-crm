# Configuracao do PostgreSQL para desenvolvimento local.
# Copie para .env e preencha a senha antes de iniciar o banco.
POSTGRES_DB=copilot_leads
POSTGRES_USER=copilot_dev
POSTGRES_PASSWORD=
# Endereco e porta publicados no Windows, usados pela API fora do container.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
